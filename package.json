{
  "name": "openmuse",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "22.x"
  },
  "cloudflare": {
    "bindings": {
      "OPENCOMPUTER_API_KEY": {
        "description": "Your OpenComputer API key (`npx opencomputer login` stores it in `~/.opencomputer/config.json`). Server only."
      },
      "OPENCOMPUTER_PROJECT_ID": {
        "description": "The OpenComputer project id `npm run setup` printed (it links or creates `openmuse-dev`)."
      },
      "OPENMUSE_OWNER_SECRET": {
        "description": "The secret you will type into the login form; `npm run setup` generated one into `.env.local`, or `openssl rand -base64 24`."
      },
      "OPENMUSE_COOKIE_SECRET": {
        "description": "Signs the owner cookie; from `.env.local`, or `openssl rand -base64 32`."
      },
      "OPENMUSE_AGENT_SECRET": {
        "description": "The installation secret the agents present; from `.env.local`, or `openssl rand -base64 32`. The app registers it with OpenComputer when you sign in."
      },
      "OPENMUSE_STORE": {
        "description": "Workers KV for the session map (which coordinator and worker sessions this installation owns); any new namespace."
      }
    }
  },
  "scripts": {
    "dev": "vite dev --port 3100",
    "dev:cloudflare": "OPENMUSE_TARGET=cloudflare vite dev --port 3100",
    "build": "vite build",
    "build:cloudflare": "OPENMUSE_TARGET=cloudflare vite build",
    "start": "srvx --prod --static ../client dist/server/server.js",
    "deploy": "npm run build:cloudflare && wrangler deploy",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "setup": "node scripts/setup.mjs",
    "prepare:agent": "node scripts/prepare-agent.mjs",
    "seed": "node scripts/seed-notes.mjs",
    "predoctor": "npm run prepare:agent",
    "doctor": "opencomputer doctor",
    "predeploy:agents": "npm run prepare:agent",
    "deploy:agents": "opencomputer deploy --alias development",
    "pretypecheck": "npm run prepare:agent",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p opencomputer/tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run doctor"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@opencomputer/react": "0.2.0",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.35",
    "@tanstack/react-start": "1.168.52",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "^0.2.6",
    "lucide-react": "1.44.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.12.4",
    "remark-gfm": "4.0.1",
    "shiki": "4.4.3",
    "sonner": "2.0.8",
    "srvx": "1.0.4",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@cloudflare/vite-plugin": "1.54.7",
    "@opencomputer/agent": "0.6.0",
    "@opencomputer/cli": "0.7.1",
    "@opencomputer/sdk": "1.1.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.14.3",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.0"
  }
}
