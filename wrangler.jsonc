{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openmuse",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The fallback return path (src/lib/return-path): one tick a minute until
  // the platform's event subscriptions deliver worker outcomes (blue #64).
  "triggers": { "crons": ["* * * * *"] },
  // The session map (which coordinator and worker sessions this installation
  // owns). `npm run deploy:cloudflare` creates the namespace and fills in the
  // id; the Deploy to Cloudflare button provisions one and rewrites the id in
  // the cloned repository.
  "kv_namespaces": [{ "binding": "OPENMUSE_STORE", "id": "openmuse-store-local" }],
  "vars": { "OPENMUSE_STATE_STORE": "kv" }
}
