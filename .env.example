# Copy to .env.local for a local run (npm run setup fills it in); on a host, set these as secrets.
# The five uncommented names are required and are what a deploy button prompts for
# (the Deploy to Cloudflare button reads this file). Everything commented out has a default.
OPENCOMPUTER_API_KEY=            # the OpenComputer key; server only, never sent to the browser
OPENCOMPUTER_PROJECT_ID=         # the linked OpenComputer project (npm run setup writes it)
OPENMUSE_OWNER_SECRET=           # what the owner types into the login form (npm run setup generates it; 16+ chars)
OPENMUSE_COOKIE_SECRET=          # signs the owner cookie (npm run setup generates it; 32+ chars)
OPENMUSE_AGENT_SECRET=           # the installation secret the agents present to /api/agent/*; the app registers it with the platform at sign-in (32+ chars)
# Optional, with defaults
# OPENCOMPUTER_ENVIRONMENT=      # development (default) or production
# OPENCOMPUTER_API_URL=          # default https://app.opencomputer.dev
# OPENMUSE_APP_ORIGIN=           # the app's public https origin; default: the origin of each request
# OPENMUSE_INSTALLATION_ID=      # part of every session idempotency key; default "default"
# OPENMUSE_COORDINATOR_AGENT=    # default openmuse-dev
# OPENMUSE_WORKER_AGENT=         # default openmuse-dev--topic-worker
# OPENMUSE_STATE_STORE=          # interim topic index and fixture notes: fs (default), kv (Cloudflare), memory (lost on restart)
# OPENMUSE_STATE_DIR=            # for fs: default ./.openmuse (the Docker image sets /data)
# OPENMUSE_MEMORY=               # fixture (default) or platform
# OPENMUSE_RETURN_PATH=          # timer: run the interim return path in-process (long-lived hosts); unset: cron or POST /api/internal/return-path/tick
# OPENMUSE_ALLOW_INSECURE_COOKIES= # 1 drops the Secure cookie attribute for plain-http localhost
# PORT=                          # for npm start; default 3000
